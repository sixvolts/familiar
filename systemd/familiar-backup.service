[Unit]
Description=Familiar DB backup (pg_dump -Fc)
After=network-online.target docker.service postgresql.service
Wants=network-online.target
# A failed dump marks this unit failed (systemctl --failed). To be told,
# point OnFailure= at a unit that notifies you, e.g.:
#OnFailure=notify-email@%n.service

[Service]
Type=oneshot
User=youruser
# Set FAMILIAR_DB_DSN here (or rely on ~/.familiar/gateway.toml's
# local_dsn). Optional: FAMILIAR_BACKUP_DIR, FAMILIAR_BACKUP_RETENTION_DAYS.
Environment=FAMILIAR_HOME=/home/youruser/.familiar
ExecStart=/home/youruser/repos/familiar-engine/systemd/backup-db.sh
